# Copiez ce fichier en `.env` puis renseignez vos valeurs.
# `.env` est ignoré par git : la clé ne doit jamais être commitée.

# Clé OpenRouter pour l'agent conversationnel (obligatoire pour le chat).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-

# Modèle OpenRouter compatible tool-calling (optionnel).
# Modèles gratuits possibles : https://openrouter.ai/collections/free-models/
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Clé d'équipe pour le serveur de prestations fictives (mode démo : demo-key).
TRAVEL_TEAM_KEY=demo-key

# URL du serveur de prestations fictives.
TRAVEL_API_URL=http://127.0.0.1:8765

# Google OAuth (optionnel — pour la connexion voyageur via Google).
# https://console.cloud.google.com/apis/credentials
# Redirect URI à déclarer : http://localhost:8766/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8766/api/auth/google/callback

# Token d'accès aux métriques Prometheus (optionnel — /metrics sans token si vide).
METRICS_TOKEN=

