# Observabilité DÉTOUR — Configuration locale.
# Copiez ce fichier en .env puis renseignez vos valeurs.

# Identifiants Grafana local (docker-compose).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Grafana Cloud (optionnel — pour le push via Alloy).
# Récupérez ces valeurs sur https://grafana.com/ -> your stack.
GRAFANA_CLOUD_URL=
GRAFANA_CLOUD_USER=
GRAFANA_CLOUD_TOKEN=