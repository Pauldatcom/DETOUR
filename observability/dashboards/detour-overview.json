{
  "annotations": { "list": [] },
  "title": "DÉTOUR — Vue d'ensemble",
  "uid": "detour-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Demandes totales",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "detour_demandes_total", "legendFormat": "Total", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed" }, "thresholds": { "mode": "absolute", "steps": [] } },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Propositions totales",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "detour_propositions_total", "legendFormat": "Total", "refId": "A" }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Demandes par statut",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "detour_demandes_par_statut", "legendFormat": "{{statut}}", "format": "table", "instant": true, "refId": "A" }
      ],
      "options": { "showHeader": true }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Demandes par statut (temporel)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "detour_demandes_par_statut", "legendFormat": "{{statut}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Logs DÉTOUR",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "{app=\"detour-conseiller\"}", "refId": "A" }
      ],
      "options": { "showTime": true, "showLabels": false, "showCommonLabels": false }
    }
  ]
}