// Configuration Alloy pour Grafana Cloud (push metrics + logs).
// Lancer avec : docker compose --profile cloud up alloy
// Variables d'environnement (fichier .env dans observability/) :
//   GRAFANA_CLOUD_URL   — URL Prometheus remote (https://...)
//   GRAFANA_CLOUD_USER   — User ID Prometheus
//   GRAFANA_CLOUD_TOKEN  — Token API Grafana Cloud

logging {
  level = "info"
}

prometheus.remote_write "cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_URL") + "/api/v1/push"
    basic_auth {
      username = env("GRAFANA_CLOUD_USER")
      password = env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

prometheus.scrape "detour" {
  targets = [
    { "__address__" = "host.docker.internal:8766", "app" = "detour-conseiller" },
  ]
  forward_to = [prometheus.remote_write.cloud.receiver]
}

loki.source.docker "containers" {
  host = "unix:///var/run/docker.sock"
  forward_to = [loki.write.cloud.receiver]
}

loki.write "cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_URL") + "/loki/api/v1/push"
    basic_auth {
      username = env("GRAFANA_CLOUD_USER")
      password = env("GRAFANA_CLOUD_TOKEN")
    }
  }
}